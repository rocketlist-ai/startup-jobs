{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rocketlist-ai/startup-jobs/blob/main/schema/jobs.schema.json",
  "title": "RocketList public job",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "company_id", "company_name", "title", "url", "active"],
  "properties": {
    "id": {"type": "string"},
    "company_id": {"type": ["string", "null"]},
    "company_name": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "title_simplified": {"type": ["string", "null"]},
    "category": {"type": ["string", "null"]},
    "subcategory": {"type": ["string", "null"]},
    "department": {"type": ["string", "null"]},
    "seniority": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "location_type": {"type": ["string", "null"]},
    "remote": {"type": "boolean"},
    "salary_min": {"type": ["number", "null"]},
    "salary_max": {"type": ["number", "null"]},
    "salary_currency": {"type": ["string", "null"]},
    "salary_range": {"type": ["string", "null"]},
    "experience_min": {"type": ["number", "null"]},
    "experience_max": {"type": ["number", "null"]},
    "required_skills": {"type": "array", "items": {"type": "string"}},
    "tech_stack": {"type": "array", "items": {"type": "string"}},
    "education": {"type": ["string", "null"]},
    "visa_sponsorship": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"], "format": "uri"},
    "source_platform": {"type": ["string", "null"]},
    "date_posted": {"type": ["string", "null"]},
    "first_seen": {"type": ["string", "null"]},
    "last_seen": {"type": ["string", "null"]},
    "active": {"const": true}
  }
}

